{
  "theme": "vscode-dark-modern.json",
  "orchestrator_mode": false,
  "plugins": {
    "orchestrator": {
      "settings": {
        "autoOpenDock": "never"
      }
    }
  },
  "file_explorer": {
    "show_hidden": true,
    "show_gitignored": true,
    "custom_ignore_patterns": [
      ".DS_Store"
    ]
  },
  "editor": {
    "auto_save_enabled": true,
    "auto_save_interval_secs": 1
  }
}
