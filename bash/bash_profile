# Homebrewのパスを通す
eval "$(/opt/homebrew/bin/brew shellenv)"

# mise で入れた node・java・marp を使う（設定は mise/config.toml）
# activate ではなく shims にする。shims は実行のたびに今のディレクトリの版を選ぶので、
# プロンプトを出さないシェル（Claude の Bash ツールなど）でもプロジェクトの mise.toml が効く
eval "$(/opt/homebrew/bin/mise activate bash --shims)"

# dotfiles のスクリプト（setup.sh が ~/.local/bin にリンクする: brew-check, marp-preview）
export PATH="$HOME/.local/bin:$PATH"

# ロケール設定（setlocale警告の対策）
# bashrc の bash-completion が LC_COLLATE を触るので、bashrc より先に設定する
export LANG=en_US.UTF-8
export LC_ALL=en_US.UTF-8

# 設定本体はbashrcに書く
[ -f ~/.bashrc ] && source ~/.bashrc
