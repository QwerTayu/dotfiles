{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/icoca/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Bash(*gws auth export*)",
      "Read(~/.config/gws*/**)",
      "Read(**/client_secret*.json)"
    ],
    "ask": [
      "Bash(*gws * send*)",
      "Bash(*gws gmail +*send*)",
      "Bash(*gws gmail +reply*)",
      "Bash(*gws gmail +forward*)",
      "Bash(*gws * delete*)",
      "Bash(*gws * trash*)",
      "Bash(*gws * remove*)",
      "Bash(*gws auth logout*)"
    ]
  },
  "language": "japanese",
  "theme": "dark",
  "agentPushNotifEnabled": true,
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  }
}
