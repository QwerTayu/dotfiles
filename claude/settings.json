{
  "permissions": {
    "deny": [
      "Bash(*gws auth export*)",
      "Read(~/.config/gws*/**)",
      "Read(**/client_secret*.json)",
      "Bash(*share.py submit*)"
    ],
    "ask": [
      "Bash(*gws * send*)",
      "Bash(*gws gmail +*send*)",
      "Bash(*gws gmail +reply*)",
      "Bash(*gws gmail +forward*)",
      "Bash(*gws * delete*)",
      "Bash(*gws * trash*)",
      "Bash(*gws * remove*)",
      "Bash(*gws auth logout*)",
      "mcp__figma-console__figma_execute",
      "mcp__figma-console__figma_execute_across_files",
      "mcp__figma-console__figma_ds_analyze",
      "mcp__figma-console__figma_ds_extract_component",
      "mcp__figma-console__figma_ds_extract_tokens",
      "mcp__figma-console__figma_ds_scaffold",
      "mcp__figma-console__figma_ds_setup_storybook",
      "mcp__figma-console__figma_ds_status",
      "mcp__figma-console__figma_ds_verify",
      "mcp__figma-console__figma_export_tokens",
      "mcp__figma-console__figma_import_tokens",
      "mcp__figma-console__figma_export_animation"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/icoca/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "language": "japanese",
  "theme": "dark",
  "agentPushNotifEnabled": true
}
